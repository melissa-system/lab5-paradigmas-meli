# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# En Vercel, crea las mismas variables en Settings > Environment Variables.

# Dominio del tenant de Auth0 (Applications > UNA Chat > Settings > Domain)
AUTH0_DOMAIN=
# Client ID de la aplicacion "UNA Chat" (Regular Web Application)
AUTH0_CLIENT_ID=
# Client Secret de la aplicacion (secreto: nunca lo compartas ni lo subas)
AUTH0_CLIENT_SECRET=
# Secreto propio para cifrar la cookie de sesion (minimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
# URL publica de la app, sin barra final. Local: http://localhost:3000  Vercel: https://<tu-proyecto>.vercel.app
BASE_URL=
